<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/zoomattendance/db" VERSION="20261001" COMMENT="XMLDB file for Moodle local/zoomattendance"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_zoomattendance_occ" COMMENT="Scheduled or inferred occurrences of a Zoom activity, snapshotted so past schedules survive mod_zoom calendar rewrites.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="zoomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The zoom.id of the activity instance."/>
        <FIELD NAME="occurrencekey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Calendar event uuid, 'single', 's:' plus a hash for inferred occurrences, or 'm:' plus a hash for manual ones."/>
        <FIELD NAME="source" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="schedule, inferred, or manual (window set by a teacher)."/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Window start."/>
        <FIELD NAME="timeend" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Window end."/>
        <FIELD NAME="status" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 active, 1 cancelled upstream, 2 excluded by a teacher."/>
        <FIELD NAME="actualsecs" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Length of the union of mapped session spans inside the window."/>
        <FIELD NAME="timecomputed" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When results were last recomputed."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="zoomid_key" UNIQUE="true" FIELDS="zoomid, occurrencekey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_zoomattendance_session" COMMENT="Sync bookkeeping: which mod_zoom session maps to which occurrence, and the data fingerprint last processed.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="detailsid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The zoom_meeting_details.id of the session."/>
        <FIELD NAME="zoomid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="occurrenceid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Mapped occurrence, null if not mapped."/>
        <FIELD NAME="fingerprint" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timesynced" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="occurrenceid" TYPE="foreign" FIELDS="occurrenceid" REFTABLE="local_zoomattendance_occ" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="detailsid" UNIQUE="true" FIELDS="detailsid"/>
        <INDEX NAME="zoomid" UNIQUE="false" FIELDS="zoomid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_zoomattendance_result" COMMENT="Attended time per occurrence and participant identity. Absent users have no row.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="occurrenceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Matched Moodle user, null for unmatched Zoom participants."/>
        <FIELD NAME="identitykey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="u:userid, or z: plus a hash for unmatched participants."/>
        <FIELD NAME="displayname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Zoom display name, only for unmatched participants."/>
        <FIELD NAME="attendedsecs" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="firstjoin" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lastleave" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="segments" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="matchstrength" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="2 email match, 1 other match, 0 unmatched."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="occurrenceid" TYPE="foreign" FIELDS="occurrenceid" REFTABLE="local_zoomattendance_occ" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="occ_identity" UNIQUE="true" FIELDS="occurrenceid, identitykey"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_zoomattendance_setting" COMMENT="Per-activity overrides. Null fields inherit the site defaults.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="presentpct" TYPE="int" LENGTH="3" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="latepct" TYPE="int" LENGTH="3" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lategracemins" TYPE="int" LENGTH="4" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="denominator" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid" UNIQUE="true" FIELDS="cmid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_zoomattendance_idmap" COMMENT="Teacher-confirmed links from an unmatched Zoom participant identity to a Moodle user, per course.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="identitykey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="The z: identity key of the unmatched participant."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The Moodle user the identity belongs to."/>
        <FIELD NAME="displayname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Zoom display name when the link was made, for reference."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_identity" UNIQUE="true" FIELDS="courseid, identitykey"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
